{
  "name": "@monky/bot",
  "version": "1.0.0",
  "description": "Monky Bot — the official universal reference bot for Monky",
  "main": "dist/index.js",
  "bin": {
    "monkybot": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "cli": "node dist/cli.js",
    "pack": "node scripts/pack.js",
    "check:sdk": "node scripts/check-sdk.js",
    "test": "npm run build && node --test",
    "smoke:pack": "node scripts/smoke-pack.js"
  },
  "keywords": ["monky", "bot", "discord-like"],
  "author": "MonkyOrg",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "monky": {
    "protocolVersion": 8
  },
  "dependencies": {
    "@monky/bot-sdk": "file:../Monky/packages/bot-sdk"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0"
  }
}
