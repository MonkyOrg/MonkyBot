{
  "name": "@monky/bot",
  "version": "1.0.0",
  "description": "Monky Bot — the official universal reference bot for Monky",
  "main": "dist/index.js",
  "bin": {
    "monkybot": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "cli": "node dist/cli.js",
    "pack": "node scripts/pack.js",
    "check:sdk": "node scripts/check-sdk.js",
    "test": "npm run build && node --test",
    "test:games:browser": "npm run build && node tests/games-browser.cjs",
    "smoke:pack": "node scripts/smoke-pack.js"
  },
  "keywords": [
    "monky",
    "bot",
    "discord-like"
  ],
  "author": "MonkyOrg",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "monky": {
    "protocolVersion": 34
  },
  "dependencies": {
    "@monky/bot-sdk": "file:vendor/monky-bot-sdk-34.0.7-beta.tgz",
    "jsnes": "2.1.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "8.18.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  }
}
