# Variaveis para execucao DIRETA (npm start / npm run dev / node dist/index.js).
# Variables for DIRECT runs (npm start / npm run dev / node dist/index.js).
#
# Com o CLI (monkybot ou npm run cli --), nao use este arquivo: o setup salva a
# conexao no perfil e "monkybot config env set NOME VALOR" salva as variaveis abaixo.
# With the CLI (monkybot or npm run cli --), do not use this file: setup saves the
# connection in the profile and "monkybot config env set NAME VALUE" saves the variables below.
# "monkybot requirements" lista portas e configuracoes; "monkybot doctor" verifica tudo.
# "monkybot requirements" lists ports and settings; "monkybot doctor" checks everything.
#
# O consentimento de quem hospeda e exigido pelo CLI (monkybot consent), nao aqui.
# Em servicos, use MONKY_HOST_CONSENT=<impressao digital de monkybot consent>; "1" nao vale mais.
# Host operator consent is enforced by the CLI (monkybot consent), not here.
# For services, use MONKY_HOST_CONSENT=<fingerprint from monkybot consent>; "1" is no longer valid.

# ── Modo Manual (um servidor) ──────────────────────────
# Para obter o token:
# 1. No app Monky → Configurações do Servidor → Bots → Gerar vínculo/token
# 2. Abra "Mostrar opção avançada" e clique "Gerar token"
# 3. Copie o token (aparece uma única vez!)
MONKY_SERVER_URL=ws://localhost:3000
MONKY_BOT_TOKEN=cole_o_token_aqui

# ── Modo Marketplace (múltiplos servidores) ────────────
# Descomente as linhas abaixo para ativar.
# Nesse modo, qualquer servidor Monky pode adicionar o bot
# colando a URL do manifest nas configurações.
# MONKY_SERVE=true
# MONKY_SERVE_PORT=7780
# MONKY_SERVE_HOST=0.0.0.0
# MONKY_SERVE_PUBLIC_HOST=seu-ip-ou-dominio

# ── Perfil (ambos os modos) ──────────────────────────
# O nome e o logo oficial são sincronizados em cada conexão.
# MONKY_BOT_NAME=MonkyBot

# ── Games (porta "games", TCP 7781, sob demanda / on demand) ─────────
# Assets e multiplayer usam um listener separado, iniciado ao chamar /doom ou /nes.
# Assets and multiplayer use a separate listener, started on the first /doom or /nes.
# A URL deve ser acessível por TODOS os jogadores; localhost serve só para teste local.
# The URL must be reachable by EVERY player; localhost is for local testing only.
# MONKY_GAMES_HOST=0.0.0.0
# MONKY_GAMES_PORT=7781
# MONKY_GAMES_PUBLIC_URL=https://games.example.com
# Sem override: http://MONKY_SERVE_PUBLIC_HOST:7781 no modo Marketplace; localhost no manual.
# Without an override: http://MONKY_SERVE_PUBLIC_HOST:7781 in marketplace mode; localhost in manual mode.
# Em produção use proxy HTTPS/WSS e libere a porta necessária no firewall.
# Use an HTTPS/WSS proxy and allow the required port through the firewall in production.

# ── Música / Music ─────────────────────────────────────
# Buscas e áudio do YouTube rodam no computador de quem pede, pelo cliente Monky;
# o host do bot não precisa de yt-dlp nem FFmpeg.
# YouTube searches and audio run on the requester's computer through the Monky client;
# the bot host needs neither yt-dlp nor FFmpeg.
# Sala vazia OU fila ociosa: desconecta após 1–600s (padrão 60).
# Empty voice room OR idle queue: disconnect after 1–600s (default 60).
# MONKY_MUSIC_GRACE_SECONDS=60

# ⚠️ Em execução direta, a chave Ed25519 (TOFU) é gerada automaticamente na
# primeira execução e salva em .keys/ do diretório atual. Com o CLI, ela fica em
# <botDir>/.keys (padrão ~/.monkybot/.keys).
